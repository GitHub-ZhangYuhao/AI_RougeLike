[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_oo2c2"]
parameter_name = "dirt_amount"
default_value_enabled = true
default_value = 0.52

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_7eigg"]
parameter_name = "stone_amount"
default_value_enabled = true
default_value = 0.28

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_krum4"]
expression = "sample_uv = uv * terrain_scale;
float wave_a = sin((uv.x * macro_scale + uv.y * 1.7) * 6.283185);
float wave_b = cos((uv.y * macro_scale * 0.73 - uv.x * 1.3) * 6.283185);
float macro = wave_a * 0.5 + wave_b * 0.5;
detail_mask = smoothstep(-0.45, 0.45, wave_a);
dirt_mask = smoothstep(0.15 - dirt_amount, 0.85 - dirt_amount, macro);
stone_mask = smoothstep(0.72 - stone_amount, 1.02 - stone_amount, wave_a * wave_b);"

